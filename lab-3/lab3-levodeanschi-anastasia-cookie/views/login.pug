doctype html
html
    head
        meta(charset="UTF-8")
        title Autentificare
        link(rel="stylesheet" href="/style.css")

    body
        h1 Autentificare

        form#login-form.create(method="post" action="/auth")
            label(for="login") Login:
            input#login(type="text" name="login" autocomplete="off" placeholder="Introdu login-ul ..." required)
            br
            br
            label(for="password") Parola:
            input#password(type="password" name="password" autocomplete="off" placeholder="Introdu parola ..." required)
            br
            br
            button(type="submit") Autentificare
        p
            |Încă nu ai un cont?
            a(href="/register")  Înregistrează-te.
        script(src="/app.js")

