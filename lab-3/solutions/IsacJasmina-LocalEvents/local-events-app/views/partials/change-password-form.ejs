<div id="passwordForm" data-show="<%= error || success ? 'true' : 'false' %>" style="margin-bottom: 2rem; width: 100%;">
  <form action="/profile/change-password" method="POST" class="form-container" style="max-width: 100%; margin: 0; border: 2px solid #ffcb96;">
    <h4 style="margin-top: 0;">Schimbă parola</h4>
    
    <div class="form-group">
      <label for="currentPassword">Parola curentă</label>
      <div class="password-wrapper">
        <input 
          type="password" 
          id="currentPassword" 
          name="currentPassword" 
          placeholder="Parola curentă"
          value="<%= formData.currentPassword || '' %>"
          class="<%= error ? 'errorInput' : '' %>"
          required>
        <button type="button" onclick="togglePasswordField('currentPassword', 'icon1')" class="password-toggle-btn">
          <i id="icon1" class="fa-solid fa-eye"></i>
        </button>
      </div>
    </div>
    
    <div class="form-group">
      <label for="newPassword">Parola nouă</label>
      <div class="password-wrapper">
        <input 
          type="password" 
          id="newPassword" 
          name="newPassword" 
          placeholder="Parola nouă (min. 6 caractere)"
          value="<%= formData.newPassword || '' %>"
          class="<%= error ? 'errorInput' : '' %>"
          required>
        <button type="button" onclick="togglePasswordField('newPassword', 'icon2')" class="password-toggle-btn">
          <i id="icon2" class="fa-solid fa-eye"></i>
        </button>
      </div>
    </div>
    
    <div class="form-group">
      <label for="confirmNewPassword">Confirmă parola nouă</label>
      <div class="password-wrapper">
        <input 
          type="password" 
          id="confirmNewPassword" 
          name="confirmNewPassword" 
          placeholder="Confirmă parola nouă"
          value="<%= formData.confirmNewPassword || '' %>"
          class="<%= error ? 'errorInput' : '' %>"
          required>
        <button type="button" onclick="togglePasswordField('confirmNewPassword', 'icon3')" class="password-toggle-btn">
          <i id="icon3" class="fa-solid fa-eye"></i>
        </button>
      </div>
    </div>
    
    <% if (error) { %>
      <div class="error" style="margin-bottom: 1rem;"><%= error %></div>
    <% } %>
    
    <% if (success) { %>
      <div style="background: #d4edda; color: #155724; padding: 0.75rem; border-radius: 5px; margin-bottom: 1rem;">
        <%= success %>
      </div>
    <% } %>
    
    <%- include('button', {
      type: 'submit',
      label: 'Salvează parola',
      icon: '💾',
      extraClass: 'btn-primary'
    }) %>
    
    <%- include('button', {
      type: 'button',
      label: 'Anulează',
      icon: '❌',
      onclick: 'togglePasswordForm()',
      extraClass: 'btn-logout',
    }) %>
  </form>
</div>