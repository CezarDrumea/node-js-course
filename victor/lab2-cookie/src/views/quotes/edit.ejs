<%- include('../partials/header', {
title: 'Edit quote',
bodyClass: 'page-quote-form',
extraCss: ['/css/quoteForm.css']
}) %>

<header class="page-header">
    <div class="stack-sm">
        <h1 class="page-title">Edit quote</h1>
        <p class="page-subtitle">Update the text or metadata for this quote.</p>
    </div>

    <div class="btn-row">
        <a href="/quotes/<%= quote.id %>" class="btn btn-ghost">← Back to details</a>
    </div>
</header>

<form action="/quotes/<%= quote.id %>" method="POST" class="form">
    <div class="form-group">
        <label class="form-label">Text</label>
        <textarea name="text" required class="form-textarea"><%= quote.text %></textarea>
    </div>

    <div class="form-group">
        <label class="form-label">Author</label>
        <input type="text" name="author" value="<%= quote.author %>" required class="form-input">
    </div>

    <div class="form-group">
        <label class="form-label">Source (movie, book, etc.)</label>
        <input type="text" name="source" value="<%= quote.source %>" class="form-input">
    </div>

    <div class="form-group">
        <label class="form-label">Type</label>
        <select name="type" class="form-select">
            <option value="movie" <%= quote.type === 'movie' ? 'selected' : '' %>>Movie</option>
            <option value="book" <%= quote.type === 'book' ? 'selected' : '' %>>Book</option>
            <option value="series" <%= quote.type === 'series' ? 'selected' : '' %>>Series</option>
            <option value="other" <%= quote.type === 'other' ? 'selected' : '' %>>Other</option>
        </select>
    </div>

    <div class="form-footer">
        <a href="/quotes/<%= quote.id %>" class="btn btn-ghost">Cancel</a>
        <button type="submit" class="btn btn-primary">Save changes</button>
    </div>
</form>

<%- include('../partials/footer') %>