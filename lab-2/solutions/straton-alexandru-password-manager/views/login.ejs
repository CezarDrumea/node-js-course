<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Password Manager - Login</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <style>
    body {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .login-container {
      width: 100%;
      max-width: 450px;
    }
    .card {
      border: none;
      border-radius: 12px;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
    }
    .card-header {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border-radius: 12px 12px 0 0 !important;
      padding: 2rem 1.5rem;
      text-align: center;
      color: white;
    }
    .card-header h2 {
      margin-bottom: 0.5rem;
      font-size: 1.75rem;
      font-weight: 700;
    }
    .card-header p {
      margin: 0;
      opacity: 0.9;
      font-size: 0.95rem;
    }
    .form-control {
      border-radius: 8px;
      border: 1px solid #e0e0e0;
      padding: 0.75rem 1rem;
      font-size: 0.95rem;
    }
    .form-control:focus {
      border-color: #667eea;
      box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }
    .btn-login {
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      border: none;
      border-radius: 8px;
      padding: 0.75rem;
      font-weight: 600;
      font-size: 1rem;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-login:hover {
      transform: translateY(-2px);
      box-shadow: 0 5px 20px rgba(102, 126, 234, 0.4);
      color: white;
    }
    .nav-tabs {
      border-bottom: 2px solid #f0f0f0;
    }
    .nav-link {
      color: #666;
      border: none;
      border-bottom: 3px solid transparent;
      font-weight: 500;
      transition: all 0.3s;
    }
    .nav-link.active {
      color: #667eea;
      border-bottom-color: #667eea;
      background: none;
    }
    .nav-link:hover {
      color: #667eea;
    }
    .alert {
      border-radius: 8px;
      border: none;
    }
    .tab-content {
      padding-top: 1.5rem;
    }
    .form-group {
      margin-bottom: 1.25rem;
    }
    .form-group label {
      font-weight: 500;
      color: #333;
      margin-bottom: 0.5rem;
    }
    .input-group-text {
      background: transparent;
      border: 1px solid #e0e0e0;
      border-right: none;
    }
    .input-group .form-control {
      border-left: none;
    }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="card">
      <div class="card-header">
        <h2><i class="bi bi-shield-lock"></i> Password Manager</h2>
        <p>Secure Authentication</p>
      </div>
      <div class="card-body p-4">
        <% if (error) { %>
          <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle"></i> <%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <ul class="nav nav-tabs mb-4" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="cookie-tab" data-bs-toggle="tab" data-bs-target="#cookie-pane" type="button" role="tab">
              <i class="bi bi-cookie"></i> Cookie Auth
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="jwt-tab" data-bs-toggle="tab" data-bs-target="#jwt-pane" type="button" role="tab">
              <i class="bi bi-key"></i> JWT Auth
            </button>
          </li>
        </ul>

        <div class="tab-content">
          <!-- Cookie Authentication -->
          <div class="tab-pane fade show active" id="cookie-pane" role="tabpanel">
            <form method="POST" action="/login-cookie">
              <div class="form-group">
                <label for="cookie-username" class="form-label">Username</label>
                <input type="text" class="form-control" id="cookie-username" name="username" placeholder="Enter your username" required>
              </div>
              <div class="form-group">
                <label for="cookie-password" class="form-label">Password</label>
                <input type="password" class="form-control" id="cookie-password" name="password" placeholder="Enter your password" required>
              </div>
              <button type="submit" class="btn btn-login btn-primary w-100">
                <i class="bi bi-box-arrow-in-right"></i> Login with Cookie
              </button>
              <small class="text-muted d-block mt-3 text-center">
                Session stored in secure HTTP-only cookie
              </small>
            </form>
          </div>

          <!-- JWT Authentication -->
          <div class="tab-pane fade" id="jwt-pane" role="tabpanel">
            <form id="jwtLoginForm">
              <div class="form-group">
                <label for="jwt-username" class="form-label">Username</label>
                <input type="text" class="form-control" id="jwt-username" placeholder="Enter your username" required>
              </div>
              <div class="form-group">
                <label for="jwt-password" class="form-label">Password</label>
                <input type="password" class="form-control" id="jwt-password" placeholder="Enter your password" required>
              </div>
              <button type="submit" class="btn btn-login btn-primary w-100">
                <i class="bi bi-box-arrow-in-right"></i> Login with JWT
              </button>
              <small class="text-muted d-block mt-3 text-center">
                Token stored in localStorage, attach to requests
              </small>
            </form>
            <div id="jwtMessage" class="mt-3"></div>
          </div>
        </div>

        <hr class="my-4">
        <div class="text-center">
          <small class="text-muted">
            <strong>Demo Credentials:</strong><br>
            Username: <code>user1</code> | Password: <code>pass1</code>
          </small>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/login.js"></script>
</body>
</html>
