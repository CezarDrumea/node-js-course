<!DOCTYPE html>
<html lang="ro">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || "Evenimente Locale" %></title>
  <link rel="icon" href="/event.png" type="image/png">
  <link rel="stylesheet" href="/styles.css">
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
  />
</head>
<body>
  <header class="header">
    <a href="/" class="logo">
      <img src="/event.png" alt="Evenimente Locale" />
      <h1>EV</h1>
    </a>
    <nav class="nav">
      <a class="nav-item" href="/">Evenimente</a>
      <a class="nav-item" href="/events/add/new">Adaugă eveniment</a>

    <% if (user) { %>
      <span class="nav-item" style="margin-left: 50px;"><%= user.username %>!</span>
      <form action="/logout" method="POST" style="display:inline;">
        <%- include('button', {
            type: 'submit',
            label: 'Logout',
            icon: '',
            extraClass: 'btn-logout'
        }) %>
      </form>
    <% } else { %>
      <%- include('button', {
          href: '/login',
          label: 'Login',
          icon: '🔑',
          extraClass: 'btn-login'
      }) %>
      <%- include('button', {
          href: '/signup',
          label: 'Sign Up',
          icon: '📝',
          extraClass: 'btn-login'
      }) %>
    <% } %>
  </nav>
  </header>

  <main>
